# Application Configuration
PROJECT_NAME="AI Powered Job Intelligence Platform"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_intelligence
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_intelligence

# JWT Authentication & Security
SECRET_KEY=change_this_to_a_secure_random_32_byte_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Credentials
ADMIN_EMAIL_ID=admin@bangalorejobs.ai
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# Ingestion / Scanning Config
SCAN_SCHEDULE_CRON="0 6 * * *"
TARGET_CITY="Bengaluru"
MAX_CONCURRENT_REQUESTS_PER_HOST=2
REQUEST_TIMEOUT_SECONDS=10

# AI / NLP Settings
ENABLE_EMBEDDINGS=False
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
OLLAMA_BASE_URL="http://localhost:11434"
